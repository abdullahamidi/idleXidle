<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ResonanceHunter.Client</RootNamespace>
    <!-- The game is IDLExIDLE (renamed 2026-08-24); the project folder keeps its old name so every path
         in the tools and the docs stays true, but the file the player runs says the game's name. -->
    <AssemblyName>IDLExIDLE</AssemblyName>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.6" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ResonanceHunter.Core\ResonanceHunter.Core.csproj" />
  </ItemGroup>
  <!--
    Copy the raw PNG assets to the output directory so the game can load them at runtime via
    Texture2D.FromStream. This deliberately sidesteps the MGCB content pipeline (no .xnb build step):
    the art is small, flat, point-sampled pixel art, so there is nothing the pipeline would add, and
    dropping-in new PNGs stays a zero-config operation.
  -->
  <ItemGroup>
    <Content Include="..\..\assets\art\**\*.png" Link="assets\art\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Audio, same pipeline-free drop-in as the art: raw WAVs copied to output, loaded by SoundBank. -->
    <Content Include="..\..\assets\audio\**\*.wav" Link="assets\audio\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      The bundled typefaces, read at runtime by SmoothFont. THIS RULE DID NOT EXIST, which meant the
      loader's bundled-font branch had never executed once: assets/fonts was never copied next to the
      executable, so every player was silently rendered in whatever bahnschrift.ttf their own Windows
      install happened to have — and on a machine without it, in the blocky pixel fallback. Both faces
      are SIL OFL, so the licences ship beside them.
    -->
    <Content Include="..\..\assets\fonts\*.ttf" Link="assets\fonts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\fonts\OFL-*.txt" Link="assets\fonts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
    <Message Text="Restoring dotnet tools (this might take a while depending on your internet speed and should only happen upon building your project for the first time, or after upgrading MonoGame, or clearing your nuget cache)" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>